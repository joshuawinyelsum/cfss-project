# Copy to backend/.env for local development. Never commit the real .env.

# Postgres connection string. A plain postgresql:// URL is accepted — the app
# rewrites it to the asyncpg driver and strips sslmode automatically.
DATABASE_URL=postgresql+asyncpg://postgres.PROJECT_REF:PASSWORD@aws-0-eu-west-1.pooler.supabase.com:6543/postgres

# JWT signing key. Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me

# Optional. Rate limiting falls back to in-process memory when unset/unreachable.
# REDIS_URL=redis://localhost:6379/0
