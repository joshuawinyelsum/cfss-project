# Copy to frontend/.env.local for local development.
#
# Base URL of the FastAPI backend, with NO trailing slash.
# In Vercel, set this in Project Settings -> Environment Variables.
# NOTE: Next.js inlines NEXT_PUBLIC_* at build time, so changing this
# requires a redeploy, not just a restart.
#
# Local:      http://127.0.0.1:8000
# Production: https://cfss-api.onrender.com
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
